# Retrieval configuration. Copy to .env (git-ignored) or set in the Cloud Run /
# GKE environment. Keep passwords in Secret Manager, never in this file.

# --- Source of truth + pgvector (Cloud SQL) ---------------------------------
DB_NAME=scrag
DB_USER=postgres
DB_PASSWORD=
INSTANCE_CONNECTION_NAME=sc-judgments-rag:asia-south1:sc-rag-pg
DB_IP_TYPE=public                  # public | private | psc
# DB_IAM_AUTH=false                # true = IAM database auth (no password)
# DB_HOST=127.0.0.1                # use instead of INSTANCE_CONNECTION_NAME with the Auth Proxy
# DB_STATEMENT_TIMEOUT_MS=5000

# Vectors are chunks.embedding vector(768); dimension is read from the column.
RETRIEVAL_METRIC=cosine            # cosine | ip | l2, must match the HNSW index opclass
# RETRIEVAL_PG_EF_SEARCH=100
# RETRIEVAL_PG_ITERATIVE_SCAN=relaxed_order   # pgvector >= 0.8

# Query embedding: the SAME model that embedded chunks.embedding (there is no
# embedding_models table). See the local section below for the two options.
RETRIEVAL_EMBEDDING_PROVIDER=local # local | vertex
RETRIEVAL_EMBEDDING_MODEL=
RETRIEVAL_QUERY_PREFIX=            # bge: "Represent this sentence for searching relevant passages: "
RETRIEVAL_NORMALIZE_EMBEDDINGS=true

# --- BM25 database (AlloyDB) -------------------------------------------------
RETRIEVAL_BM25_BACKEND=postgres    # postgres | none (index built by a separate cloud job)
BM25_DB_NAME=
BM25_DB_USER=
BM25_DB_PASSWORD=
BM25_INSTANCE_URI=                 # projects/<project>/locations/<region>/clusters/<cluster>/instances/<instance>
BM25_DB_IP_TYPE=private            # AlloyDB is private-IP unless public IP is enabled
# RETRIEVAL_BM25_SCHEMA=bm25
# RETRIEVAL_BM25_POSTINGS_PER_TERM=2000   # 0 = exact scoring of every posting

# --- Ranking: vector + BM25 candidates -> cross-encoder rerank -> top_k --------
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATE_K=20           # from EACH retriever, so up to 40 get reranked
RETRIEVAL_MAX_PER_DOC=3            # 0 = no per-judgment cap
RETRIEVAL_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RETRIEVAL_RERANKER_MAX_LENGTH=256
RETRIEVAL_TIMEOUT_SECONDS=10

# --- Local run against the ingestion team's SQLite export ----------------------
# Uncomment to run without Cloud SQL / AlloyDB (vectors and BM25 held in memory).
# RETRIEVAL_VECTOR_STORE=sqlite
# RETRIEVAL_SQLITE_PATH=output/scj_rag_v2.db
# RETRIEVAL_BM25_BACKEND=memory                  # built at startup (a minute or two)
# RETRIEVAL_REQUIRE_UUIDS=false                  # only if the export's ids are not UUIDs
# RETRIEVAL_EMBEDDING_DIMENSIONS=768
# One SELECT mapping the export's schema; must return citable chunks with aliases
# chunk_id, document_id, source_pdf_id, page_start, page_end, content, embedding
# (optional: decision_date, case_name). Default assumes the Postgres column names:
# RETRIEVAL_SQLITE_CHUNKS_SQL=SELECT c.chunk_uuid AS chunk_id, c.judgment_uuid AS document_id, c.source_file_uuid AS source_pdf_id, c.page_start, c.page_end, c.content, c.embedding FROM chunks c WHERE c.is_active = 1 AND c.embedding IS NOT NULL
#
# Query embedding: must be the SAME model that embedded the chunks. Pick one:
# (a) local CPU, no credentials
# RETRIEVAL_EMBEDDING_PROVIDER=local
# RETRIEVAL_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# RETRIEVAL_QUERY_PREFIX=Represent this sentence for searching relevant passages: 
# (b) Vertex AI
# RETRIEVAL_EMBEDDING_PROVIDER=vertex
# RETRIEVAL_EMBEDDING_MODEL=text-embedding-004
# GCP_PROJECT=your-gcp-project-id
# GCP_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service_account_key.json
