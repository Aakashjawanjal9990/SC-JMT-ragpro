# ==============================================================================
# Supreme Court Judgment RAG — Configuration Template (.env.example)
# Rename this file to .env and configure for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Cloud Platform (GCP) & Cloud Storage (GCS)
# ------------------------------------------------------------------------------
GCP_PROJECT=your-gcp-project-id
GCP_LOCATION=us-central1
GCS_BUCKET=your-gcs-bucket-name
GCS_PREFIX=raw_pdfs/pdfs

# Optional: Path to Service Account JSON key (if not using Workload Identity / gcloud)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ------------------------------------------------------------------------------
# 2. Database & Google Cloud AlloyDB (PostgreSQL 17) Credentials
# ------------------------------------------------------------------------------
# Database Target Selector: 'local' (SQLite) or 'alloydb' (PostgreSQL 17 Cluster)
DATABASE_TARGET=local

# Option A: Full Connection URI
# Local SQLite development database (default):
DATABASE_URL=sqlite:///output/scj_rag_v2.db

# Production Google Cloud AlloyDB (PostgreSQL 17.10 with Native BM25 & pgvector HNSW):
# DATABASE_URL=postgresql+psycopg2://<user>:<URL-encoded-password>@<private-host>:5432/<database>?sslmode=require
# ALLOYDB_DATABASE_URL=postgresql+psycopg2://<user>:<URL-encoded-password>@<private-host>:5432/<database>?sslmode=require

# Option B: Individual AlloyDB / PostgreSQL Credentials
# DB_USER=<secret-managed-user>
# DB_PASSWORD=<secret-managed-password>
# DB_HOST=<private-alloydb-host>
# DB_PORT=5432
# DB_NAME=<database-name>
# DB_SSLMODE=require

# ------------------------------------------------------------------------------
# 3. Vertex AI Embedding Engine & Fail-Closed Safety
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL_ID=text-embedding-004
EMBEDDING_DIMENSION=768
BATCH_SIZE=64
MAX_RETRIES=3
VECTOR_MODE=external

# CRITICAL: Set to 'false' in production to enforce real Vertex AI embedding calls.
# Set to 'true' ONLY in offline development or local testing.
ALLOW_MOCK_EMBEDDINGS=false

# ------------------------------------------------------------------------------
# 4. Pipeline Chunking & Bounds
# ------------------------------------------------------------------------------
TARGET_CHUNK_CHARS=1500
MAX_CHUNK_CHARS=2000
MIN_CHUNK_CHARS=150
MIN_ALPHA_CHARS=15
CHUNK_OVERLAP_CHARS=150
MAX_OVERLAP_CHARS=300
LABEL_CONFIDENCE_THRESHOLD=0.75

# ------------------------------------------------------------------------------
# 5. Quality & Integrity Verification Thresholds
# ------------------------------------------------------------------------------
RETRIEVAL_MIN_RECALL=0.25
VECTOR_NORM_TOLERANCE=0.10
AUDIT_SAMPLE_LIMIT=500
VECTOR_CHECK_SAMPLE_LIMIT=50

# ------------------------------------------------------------------------------
# 6. Layout Zone Coordinate Thresholds (PyMuPDF)
# ------------------------------------------------------------------------------
HISTORICAL_GAP_THRESHOLD=15.0
DIGITAL_GAP_THRESHOLD=13.5
HEADER_Y_MAX_BORN_DIGITAL=85.0
HEADER_Y_MAX_HISTORICAL=75.0

# ------------------------------------------------------------------------------
# 7. Pipeline Identity & Batch Ingestion
# ------------------------------------------------------------------------------
PIPELINE_NAME=scj-data-ingestion-v3
PIPELINE_VERSION=v3.0
CHUNKING_VERSION=v3.0
CLEANING_VERSION=v3.0
EMBEDDING_VERSION=v3.0_short
DEFAULT_INGESTION_WORKERS=6

# ------------------------------------------------------------------------------
# 8. Local Conditional PaddleOCR & PP-StructureV3 Configuration
# ------------------------------------------------------------------------------
ENABLE_LOCAL_OCR=true
PADDLE_OCR_LANG=en
PADDLE_OCR_USE_GPU=false
PADDLE_PDX_CACHE_HOME=output/paddlex_cache
OCR_QUALITY_FLOOR=0.35
OCR_QUALITY_BORDERLINE=0.60
OCR_QUALITY_RELIABLE=0.65
OCR_MIN_TEXT_LENGTH=30
OCR_REPLACEMENT_CHAR_RATIO_MAX=0.01
PADDLE_OCR_VERSION=PP-OCRv4
ENABLE_PP_STRUCTURE=true
