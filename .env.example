# Base URL of the FastAPI backend, including the /api prefix.
# Development: http://localhost:8000/api
# Production: must be https:// (the build fails otherwise).
VITE_API_URL=http://localhost:8000/api

# Sign-in uses an HttpOnly session cookie set by the backend. The API must
# allow this site's exact origin with credentials (CORS). Optional: the names
# the backend uses for CSRF protection (defaults shown).
# VITE_CSRF_HEADER=X-CSRF-Token
# VITE_CSRF_COOKIE=csrf_token