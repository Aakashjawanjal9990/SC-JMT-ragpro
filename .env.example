# Retrieval configuration. Copy to .env (git-ignored) or set in Cloud Run.
# Keep passwords in Secret Manager, never in this file.

# --- Source of truth + vector search (Cloud SQL Postgres + pgvector) -----------
# Needs the `vector` extension and chunks(chunk_uuid, judgment_uuid, source_file_uuid,
# page_start, page_end, content, is_active, embedding vector(768)); checked at startup.
DB_NAME=scrag
DB_USER=postgres
DB_PASSWORD=
INSTANCE_CONNECTION_NAME=sc-judgments-rag:asia-south1:sc-rag-pg
DB_IP_TYPE=public                  # public | private | psc
# DB_IAM_AUTH=false                # true = IAM database auth (no password)
# DB_HOST=127.0.0.1                # instead of INSTANCE_CONNECTION_NAME, via the Auth Proxy
# DB_STATEMENT_TIMEOUT_MS=5000
RETRIEVAL_METRIC=cosine            # must match the HNSW index opclass on chunks.embedding
# RETRIEVAL_PG_EF_SEARCH=100
# RETRIEVAL_PG_ITERATIVE_SCAN=relaxed_order   # pgvector >= 0.8

# --- Query embedding: the SAME model that embedded chunks.embedding ------------
RETRIEVAL_EMBEDDING_PROVIDER=vertex          # vertex | local (needs sentence-transformers)
RETRIEVAL_EMBEDDING_MODEL=text-embedding-004 # confirm with ingestion
RETRIEVAL_EMBEDDING_DIMENSIONS=768
GCP_PROJECT=sc-judgments-rag
GCP_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json   # local only; Cloud Run uses its service account
# For local bge instead: RETRIEVAL_EMBEDDING_PROVIDER=local, RETRIEVAL_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5,
# RETRIEVAL_QUERY_PREFIX=Represent this sentence for searching relevant passages:
RETRIEVAL_NORMALIZE_EMBEDDINGS=true

# --- Lexical search (BM25) ------------------------------------------------------
RETRIEVAL_BM25_BACKEND=memory      # memory (built at startup from chunks) | postgres (AlloyDB) | none
# Only for RETRIEVAL_BM25_BACKEND=postgres:
# BM25_DB_NAME= / BM25_DB_USER= / BM25_DB_PASSWORD= / BM25_INSTANCE_URI= / BM25_DB_IP_TYPE=private
# RETRIEVAL_BM25_SCHEMA=bm25

# --- Ranking: vector + BM25 candidates -> reranker (or rank fusion) -> top_k ----
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATE_K=20           # from EACH retriever
RETRIEVAL_MAX_PER_DOC=3            # 0 = no per-judgment cap
RETRIEVAL_RERANKER=none            # none | vertex (Vertex AI Ranking API) | cross-encoder (local)
# RETRIEVAL_RERANKER_MODEL=        # default: semantic-ranker-default@latest (vertex) / ms-marco-MiniLM-L-6-v2 (cross-encoder)
# RETRIEVAL_RERANKER_LOCATION=global
RETRIEVAL_TIMEOUT_SECONDS=10
RETRIEVAL_REQUIRE_UUIDS=true

# --- Local run against the ingestion team's SQLite export (optional) ------------
# RETRIEVAL_VECTOR_STORE=sqlite
# RETRIEVAL_SQLITE_PATH=output/scj_rag_v2.db
# RETRIEVAL_REQUIRE_UUIDS=false    # only if the export's ids are not UUIDs
# RETRIEVAL_SQLITE_CHUNKS_SQL=SELECT c.chunk_uuid AS chunk_id, c.judgment_uuid AS document_id, c.source_file_uuid AS source_pdf_id, c.page_start, c.page_end, c.content, c.embedding FROM chunks c WHERE c.is_active = 1 AND c.embedding IS NOT NULL
