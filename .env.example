# ==============================================================================
# Supreme Court Judgment RAG — PCE v2.0 Configuration
# Rename this file to .env and fill in your environment-specific credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Cloud Platform (GCP) & Cloud Storage (GCS)
# ------------------------------------------------------------------------------
GCP_PROJECT=sc-judgments-rag-prod
GCP_LOCATION=us-central1
GCS_BUCKET=sc-judgments-rag-prod-data
GCS_PREFIX=raw_pdfs/pdfs

# Optional: Path to GCP Service Account JSON key file (if not using Workload Identity / gcloud auth)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ------------------------------------------------------------------------------
# 2. Database & Cloud SQL Credentials
# ------------------------------------------------------------------------------
# Option A: Full Connection URI (PostgreSQL Cloud SQL or Local)
DATABASE_URL=postgresql+psycopg2://postgres:your_password@127.0.0.1:5432/sc_judgments_db
# For local development with SQLite, leave DATABASE_URL unset or set to:
# DATABASE_URL=sqlite:///output/scj_rag_v2.db

# Option B: Individual PostgreSQL / Cloud SQL Credentials (used if DATABASE_URL is not set)
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=sc_judgments_db
# Cloud SQL Connection Name (when connecting via Cloud SQL Auth Proxy):
# CLOUD_SQL_CONNECTION_NAME=sc-judgments-rag-prod:us-central1:scj-db-instance

# ------------------------------------------------------------------------------
# 3. Vertex AI Embedding Engine
# ------------------------------------------------------------------------------
EMBEDDING_MODEL_ID=text-embedding-004
EMBEDDING_DIMENSION=768
BATCH_SIZE=64
VECTOR_MODE=external
# Set to 'false' in production to enforce real Vertex AI embedding calls
ALLOW_MOCK_EMBEDDINGS=false

# ------------------------------------------------------------------------------
# 4. Pipeline Chunking & Quality Thresholds
# ------------------------------------------------------------------------------
TARGET_CHUNK_CHARS=1500
MAX_CHUNK_CHARS=2000
MIN_CHUNK_CHARS=150
CHUNK_OVERLAP_CHARS=150
OCR_QUALITY_FLOOR=0.60
LABEL_CONFIDENCE_THRESHOLD=0.75
