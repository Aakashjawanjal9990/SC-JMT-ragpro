# Base URL of the FastAPI backend, including the /api prefix.
# Development: http://localhost:8000/api
# Production: must be https:// (the build fails otherwise).
VITE_API_URL=http://localhost:8000/api

# Sign-in uses an HttpOnly session cookie set by the backend. The API must
# allow this site's exact origin with credentials (CORS), and allow the
# `X-CSRF-Token` request header. The CSRF token comes from the `csrfToken`
# field of the login and /auth/me replies and is kept in memory only.
