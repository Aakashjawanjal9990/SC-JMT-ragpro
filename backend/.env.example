# Local development values only. Never use these credentials in a deployed service.
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MAX_CONTEXT_CHARS=80000
REQUEST_TIMEOUT_SECONDS=20
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
DATABASE_URL=postgresql+asyncpg://rag:rag@postgres:5432/rag
REDIS_URL=redis://redis:6379/0
AUTH_CHALLENGE_SECRET=local-development-only-change-before-deployment
SESSION_COOKIE_NAME=nm_session
SESSION_COOKIE_SAMESITE=lax
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM_EMAIL=no-reply@localhost
SMTP_STARTTLS=false

# Optional for local Vertex AI testing with Application Default Credentials.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
VERTEX_MODEL_ID=
VERTEX_EMBEDDING_MODEL_ID=gemini-embedding-001

# Pratik's optional RetrievalPort adapter. It reads the source connection from
# DATABASE_URL unless DB_NAME/DB_USER/DB_PASSWORD/INSTANCE_CONNECTION_NAME are
# explicitly supplied. BM25 defaults to none because no AlloyDB BM25 instance
# is currently part of this deployment. Enable the adapter after an active,
# locally loadable embedding_models row is configured; otherwise the backend
# uses its existing Vertex + Cloud SQL retrieval adapter.
RETRIEVAL_PORT_ADAPTER_ENABLED=false
RETRIEVAL_BM25_BACKEND=none
