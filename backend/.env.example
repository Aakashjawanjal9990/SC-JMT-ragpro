# Local development values only. Never use these credentials in a deployed service.
APP_ENV=development
LOCAL_TEST_MODE=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
MAX_CONTEXT_CHARS=80000
REQUEST_TIMEOUT_SECONDS=20
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
DATABASE_URL=postgresql+asyncpg://rag:rag@postgres:5432/rag
REDIS_URL=redis://redis:6379/0
AUTH_CHALLENGE_SECRET=local-development-only-change-before-deployment
SESSION_COOKIE_NAME=nm_session
ADMIN_SESSION_COOKIE_NAME=nm_admin_session
SESSION_COOKIE_SAMESITE=lax
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM_EMAIL=no-reply@localhost
SMTP_STARTTLS=false

# Optional for local Vertex AI testing with Application Default Credentials.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
VERTEX_MODEL_ID=
VERTEX_EMBEDDING_MODEL_ID=gemini-embedding-001

# Optional retrieval-module adapter. Production uses pgvector. Local E2E can use
# the ingestion team's read-only SQLite export mounted at /data/scj_rag_v2.db.
RETRIEVAL_PORT_ADAPTER_ENABLED=false
RETRIEVAL_VECTOR_STORE=pgvector
RETRIEVAL_SQLITE_PATH=/data/scj_rag_v2.db
RETRIEVAL_EMBEDDING_MODEL=text-embedding-004
RETRIEVAL_EMBEDDING_PROVIDER=vertex
RETRIEVAL_EMBEDDING_DIMENSIONS=768
RETRIEVAL_BM25_BACKEND=none
RETRIEVAL_BM25_POSTINGS_PER_TERM=2000
# This host path is mounted read-only into the API container for local SQLite E2E.
RAG_SQLITE_PATH=../ingestion/output/scj_rag_v2.db
# Only for local adapter wiring checks; the hash vectors are not semantic embeddings.
# RETRIEVAL_EMBEDDING_PROVIDER=test
