# Local development values only. Never use these credentials in a deployed service.
APP_ENV=development
LOCAL_TEST_MODE=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
MAX_CONTEXT_CHARS=80000
REQUEST_TIMEOUT_SECONDS=45
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
# Local Compose PostgreSQL is for auth/API development. For BM25 query testing,
# point DATABASE_URL to AlloyDB with pg_textsearch enabled and idx_chunks_bm25 present.
DATABASE_URL=postgresql+asyncpg://rag:rag@postgres:5432/rag
REDIS_URL=redis://redis:6379/0
AUTH_CHALLENGE_SECRET=local-development-only-change-before-deployment
SESSION_COOKIE_NAME=nm_session
ADMIN_SESSION_COOKIE_NAME=nm_admin_session
SESSION_COOKIE_SAMESITE=lax
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM_EMAIL=no-reply@localhost
SMTP_STARTTLS=false

# Groq is used for grounded answer generation and optional query expansion.
GROQ_API_KEY=
GROQ_MODEL_ID=openai/gpt-oss-120b
GROQ_GENERATION_REASONING_EFFORT=medium
GROQ_GENERATION_MAX_TOKENS=2000
GROQ_GENERATION_TIMEOUT_SECONDS=30
GROQ_MAX_PASSAGE_CHARS=6000
GROQ_MAX_CONTEXT_CHARS=48000

# The default AlloyDB adapter uses the native pg_textsearch BM25 index on chunks.content.
# The optional legacy retrieval module is disabled; it is not needed for query serving.
RETRIEVAL_PORT_ADAPTER_ENABLED=false
